# Exemplo de variáveis de ambiente do Backend
PROJECT_NAME="NexusChat"
API_V1_STR="/api/v1"

# Banco de Dados (Conexão direta com PostgreSQL ou via pooler PgBouncer)
DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@db:5432/projetobase"
# Se for utilizar o PgBouncer:
# DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@pgbouncer:5432/projetobase"

# [OPCIONAL] Tamanho do pool base de conexões SQLAlchemy e limite de overflow
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# [OPCIONAL / RECOMENDADO PARA ESCALA] Redis Pub/Sub para WebSockets Distribuídos e Cache
REDIS_URL="redis://localhost:6379/0"
# No Docker Compose local:
# REDIS_URL="redis://redis:6379/0"

# [OPCIONAL / RECOMENDADO PARA ALTA ESCALA] Servidor LiveKit SFU (Voz & Vídeo em Massa)
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret_livekit_key_2026_discord_clone"

# Segurança JWT
SECRET_KEY="supersecret-jwt-key-projeto-base-981273491"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Credenciais Iniciais do Super Admin
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="aryarajmarketing@gmail.com"
SUPERADMIN_PASSWORD="SuperAdmin@2026!"

# Pepper do Sistema (Argon2id + HMAC-SHA256 - Chave Secreta do Servidor)
SECURITY_PASSWORD_PEPPER="d6e3f89a2b5c4701e1c9d8a4f3b207e691238475a1092837465bcdf012938475"

# [OPCIONAL] Origens permitidas para requisições CORS com credenciais (separadas por vírgula)
CORS_ORIGINS="http://localhost:3005,http://localhost:5173,http://localhost:3000,http://127.0.0.1:3005,http://127.0.0.1:5173,http://127.0.0.1:3000"

# [OPCIONAL] Ativação do Rate Limiting em memória e Redis (True/False)
RATELIMIT_ENABLED="True"

# Brevo (Envio de E-mail via API REST)
BREVO_API_KEY="xkeysib-seu-api-key-aqui"
BREVO_SENDER_EMAIL="remetente-validado@seudominio.com"
BREVO_SENDER_NAME="NexusChat"

# [OPCIONAL / RECOMENDADO] Armazenamento de Backups e Mídias em Nuvem (Backblaze B2 / AWS S3)
# O sistema aceita tanto BACKBLAZE_* quanto B2_*
BACKBLAZE_ENDPOINT_URL="https://s3.us-west-004.backblazeb2.com"
BACKBLAZE_KEY_ID="seu-application-key-id"
BACKBLAZE_APPLICATION_KEY="seu-application-key-secreto"
BACKBLAZE_BUCKET_NAME="seu-bucket-de-midias-e-backup"
BACKBLAZE_CDN_URL="https://s3.us-west-004.backblazeb2.com/seu-bucket-de-midias-e-backup"
B2_FOLDER="projetobase/backups/"
# Pasta dentro do bucket para anexos de mensagens, áudios e imagens
B2_MEDIA_FOLDER="discord_media/"
# Limite máximo de retenção de dumps no S3 antes de expurgar o mais antigo
B2_RETENTION_MAX=30
